# Environment variables for the tabular_data_loader benchmark test
# (test_component_benchmark.py). Copy to `.env` and fill in real values.
#
# The test loads this directory's `.env` automatically (no need to source it):
#
#   cp .env.example .env
#   # edit .env, then from the repo root:
#   uv run pytest components/data_processing/automl/tabular_data_loader/tests/test_component_benchmark.py \
#       -m integration -v -s --log-cli-level=DEBUG
#
# Precedence: real shell environment variables > this directory's `.env` >
# the repo-root `.env`. Requires python-dotenv (`uv sync --extra test_automl`);
# without it the test falls back to shell environment variables only.

# --- S3 credentials (read by the component's get_s3_client) -------------------
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_ENDPOINT=https://s3.example.com
# Optional; leave empty if not applicable to your endpoint.
AWS_DEFAULT_REGION=us-east-1

# --- Benchmark dataset locations ----------------------------------------------
# Bucket holding both datasets (falls back to AWS_S3_BUCKET if BENCH_BUCKET unset).
BENCH_BUCKET=my-benchmark-bucket

# Dataset 1: classification -> binary task, stratified sampling.
BENCH_BINARY_KEY=path/to/binary_dataset.csv
BENCH_BINARY_LABEL=target

# Dataset 2: regression task, random sampling.
BENCH_REGRESSION_KEY=path/to/regression_dataset.csv
BENCH_REGRESSION_LABEL=price