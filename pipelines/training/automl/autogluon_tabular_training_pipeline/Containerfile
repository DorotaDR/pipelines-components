ARG BASE_IMAGE="quay.io/aipcc/base-images/cpu-el9.8:3.6.0-ea.2"

## Build stage: build a kfp-components wheel from the local source tree
FROM ${BASE_IMAGE} AS builder
RUN mkdir /tmp/kfp-src /tmp/dist
COPY pyproject.toml __init__.py /tmp/kfp-src/
COPY components/ /tmp/kfp-src/components/
COPY pipelines/ /tmp/kfp-src/pipelines/
COPY utils/ /tmp/kfp-src/utils/
# Using default RH index from the BASE_IMAGE
RUN pip install --no-cache-dir setuptools==80.10.2 && \
    pip wheel --no-deps --no-build-isolation -w /tmp/dist /tmp/kfp-src/

FROM ${BASE_IMAGE}

COPY --from=builder /tmp/dist/kfp_components-*.whl /tmp/
RUN pip install --no-cache-dir --no-deps /tmp/kfp_components-*.whl

COPY pipelines/training/automl/autogluon_tabular_training_pipeline/requirements.in /tmp/

# These two dependencies are not available at the versions needed by the
# AutoGluon branch in the RHOAI index. Install only their wheels from PyPI;
# pip resolves their dependencies with the rest from the RHOAI index below.
RUN pip install --no-cache-dir --no-deps --index-url https://pypi.org/simple/ \
      'gluonts>=0.17,<0.18' 'xgboost-cpu<3.4'

# Resolve the non-AutoGluon dependencies from the RHOAI index in requirements.in
# and build the AutoGluon family from the same GitHub branch.
RUN sed '/^autogluon\./d' /tmp/requirements.in > /tmp/requirements-poc.in && \
    pip install --no-cache-dir -r /tmp/requirements-poc.in \
      'autogluon.common @ git+https://github.com/DorotaDR/autogluon.git@prepare-v1.6.3+rhaiv.1#subdirectory=common' \
      'autogluon.core @ git+https://github.com/DorotaDR/autogluon.git@prepare-v1.6.3+rhaiv.1#subdirectory=core' \
      'autogluon.features @ git+https://github.com/DorotaDR/autogluon.git@prepare-v1.6.3+rhaiv.1#subdirectory=features' \
      'autogluon.tabular[lightgbm,xgboost,tabm,fastai] @ git+https://github.com/DorotaDR/autogluon.git@prepare-v1.6.3+rhaiv.1#subdirectory=tabular' \
      'autogluon.timeseries @ git+https://github.com/DorotaDR/autogluon.git@prepare-v1.6.3+rhaiv.1#subdirectory=timeseries'
RUN pip check
