ARG BASE_IMAGE="quay.io/aipcc/base-images/cpu-el9.8:3.6.0-ea.2"

## Build stage: build a kfp-components wheel from the local source tree
FROM ${BASE_IMAGE} AS builder
RUN mkdir /tmp/kfp-src /tmp/dist
COPY pyproject.toml __init__.py /tmp/kfp-src/
COPY components/ /tmp/kfp-src/components/
COPY pipelines/ /tmp/kfp-src/pipelines/
COPY utils/ /tmp/kfp-src/utils/
# Using default RH index from the BASE_IMAGE
RUN pip install --no-cache-dir setuptools==80.10.2 && \
    pip wheel --no-deps --no-build-isolation -w /tmp/dist /tmp/kfp-src/

FROM ${BASE_IMAGE}

COPY --from=builder /tmp/dist/kfp_components-*.whl /tmp/
RUN pip install --no-cache-dir --no-deps /tmp/kfp_components-*.whl

COPY pipelines/training/automl/autogluon_tabular_training_pipeline/requirements.in /tmp/

# TEMPORARY (test only): install autogluon from git fork; all other deps from requirements.in
# AIPCC base images are non-root and have no dnf repos, so fetch source via GitHub archive (no git).
ARG AUTOGLUON_GIT_REPO=https://github.com/DorotaDR/autogluon.git
ARG AUTOGLUON_GIT_BRANCH=remove-fastcore-limitation-rhai.v6
RUN grep -v '^autogluon' /tmp/requirements.in > /tmp/requirements-no-autogluon.in && \
    pip install --no-cache-dir -r /tmp/requirements-no-autogluon.in && \
    curl -fsSL "${AUTOGLUON_GIT_REPO%.git}/archive/refs/heads/${AUTOGLUON_GIT_BRANCH}.tar.gz" -o /tmp/autogluon.tar.gz && \
    tar -xzf /tmp/autogluon.tar.gz -C /tmp && \
    pip install --no-cache-dir \
        "/tmp/autogluon-${AUTOGLUON_GIT_BRANCH}/common" \
        "/tmp/autogluon-${AUTOGLUON_GIT_BRANCH}/core" \
        "/tmp/autogluon-${AUTOGLUON_GIT_BRANCH}/features" \
        "/tmp/autogluon-${AUTOGLUON_GIT_BRANCH}/tabular[lightgbm,xgboost,tabm,fastai]" \
        "/tmp/autogluon-${AUTOGLUON_GIT_BRANCH}/timeseries" && \
    rm -rf /tmp/autogluon.tar.gz "/tmp/autogluon-${AUTOGLUON_GIT_BRANCH}"
RUN pip check

