# This container is used to run the AutoRAG components of the training pipeline.
#
# Build context: this directory (not the repo root). Example from repo root:
#   nerdctl build --platform=linux/amd64 \
#     -f pipelines/training/autorag/documents_rag_optimization_pipeline/Containerfile \
#     -t documents-rag-opt:test \
#     pipelines/training/autorag/documents_rag_optimization_pipeline

# Docling ONNX models from ModelCar images (COPY --from). Override for prod registry if needed.
# ARGs used in FROM must be declared before any FROM (Buildah/Konflux).
ARG BASE_IMAGE="quay.io/aipcc/base-images/cpu:3.4"
ARG DOCLING_LAYOUT_MODELCAR=registry.stage.redhat.io/rhai/modelcar-docling-project-docling-layout-heron:3.0
ARG DOCLING_MODELS_MODELCAR=registry.stage.redhat.io/rhai/modelcar-docling-project-docling-models:3.0

FROM ${DOCLING_LAYOUT_MODELCAR} AS docling-layout-heron
FROM ${DOCLING_MODELS_MODELCAR} AS docling-models
FROM ${BASE_IMAGE}

COPY requirements.txt requirements-pypi.txt requirements-pypi-whl.txt /tmp/
COPY artifacts.lock.yaml install_sqlite_from_source.sh /tmp/

# Build SQLite from sqlite-autoconf (Hermeto generic prefetch or download); replace system libsqlite3.
# https://github.com/hermetoproject/hermeto/blob/main/docs/generic.md
ARG HERMETO_GENERIC_DEPS=/cachi2/output/deps/generic

# Build SQLite from sqlite-autoconf (Hermeto generic prefetch or download); replace system libsqlite3.
USER root
RUN HERMETO_GENERIC_DEPS="${HERMETO_GENERIC_DEPS}" bash /tmp/install_sqlite_from_source.sh
USER default

## TODO: Ensure build isolation
RUN pip install --index-url https://console.redhat.com/api/pypi/public-rhai/rhoai/3.4/cpu-ubi9/simple --no-cache-dir -r /tmp/requirements.txt
RUN pip install --index-url https://pypi.org/simple --no-cache-dir -r /tmp/requirements-pypi.txt
RUN pip install --index-url https://pypi.org/simple --no-cache-dir -r /tmp/requirements-pypi-whl.txt

# Docling models for offline text extraction (ModelCar images; docling expects docling-project--* dirs).
# Do not use /opt/docling-artifacts on aipcc: non-root RUN cannot mkdir there (Permission denied).
ENV DOCLING_ARTIFACTS_PATH=/opt/app-root/docling-artifacts/models
USER root
RUN mkdir -p \
      /opt/app-root/docling-artifacts/models/docling-project--docling-layout-heron \
      /opt/app-root/docling-artifacts/models/docling-project--docling-models
COPY --from=docling-layout-heron /models/ /opt/app-root/docling-artifacts/models/docling-project--docling-layout-heron/
COPY --from=docling-models /models/ /opt/app-root/docling-artifacts/models/docling-project--docling-models/
RUN chown -R 1001:0 /opt/app-root/docling-artifacts
USER default
